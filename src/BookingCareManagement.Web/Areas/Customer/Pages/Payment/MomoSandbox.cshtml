@page "/payment/momo/sandbox"
@model BookingCareManagement.Areas.Customer.Pages.Payment.MomoSandboxModel
@{
    ViewData["Title"] = "MoMo Sandbox";
}

<style>
    .momo-shell {
        min-height: 100vh;
        background: #f7f7fb;
    }
    .momo-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }
    .momo-logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        color: #b0006d;
    }
    .momo-qr-panel {
        background: linear-gradient(135deg, #ff4aa2, #b1007c);
        border-radius: 14px;
        padding: 20px;
        color: #fff;
    }
    .momo-qr {
        width: 260px;
        height: 260px;
        background: #fff;
        border-radius: 10px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .momo-info {
        border: 1px solid #f0f0f4;
        border-radius: 12px;
        padding: 16px;
    }
    .momo-amount { color: #14b87a; font-weight: 700; font-size: 22px; }
    .momo-muted { color: #6b7280; }
</style>

<div class="momo-shell py-4">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="momo-logo">
                <img src="https://static.mservice.io/img/icon/logo-momo.svg" alt="momo" width="28" height="28" />
                Cổng thanh toán @Model.MethodDisplay
            </span>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="momo-card p-4">
                    <h5 class="mb-3">Thông tin đơn hàng</h5>
                    <div class="momo-info">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="momo-muted">Nhà cung cấp</span>
                            <span>@Model.MethodDisplay</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="momo-muted">Mã đơn hàng</span>
                            <span>MOMO@Model.Token.Substring(0, Math.Min(8, Model.Token.Length)).ToUpperInvariant()</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="momo-muted">Mô tả</span>
                            <span>Thanh toán đặt lịch</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="momo-muted">Số tiền</span>
                            <span class="momo-amount">@Model.AmountDisplay</span>
                        </div>
                    </div>

                    <div class="mt-3 momo-muted">Đơn hàng sẽ hết hạn sau: <span id="countdown">05:00</span></div>
                    <div class="mt-3 d-grid gap-2">
                        <button id="btn-simulate" class="btn btn-success">Giả lập thanh toán thành công</button>
                        <a class="btn btn-outline-secondary" href="/booking">Quay lại đặt lịch</a>
                    </div>
                    <div id="result" class="mt-3 text-success d-none">Thanh toán thành công! Đang chuyển hướng...</div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="momo-card p-4">
                    <div class="momo-qr-panel d-flex flex-column align-items-center">
                        <h5 class="mb-3">Quét mã QR để thanh toán</h5>
                        <div class="momo-qr">
                            <canvas id="qr-canvas" width="240" height="240"></canvas>
                        </div>
                        <div class="mt-3 text-center">
                            Sử dụng app @Model.MethodDisplay để quét mã
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = "@Model.Token";
        const method = "@Model.Method";
        const amount = "@Model.AmountDisplay";

        const btn = document.getElementById("btn-simulate");
        const result = document.getElementById("result");
        const countdown = document.getElementById("countdown");

        // QR payload for sandbox
        const qrPayload = JSON.stringify({ token, method, amount });

        // Render QR using CDN
        const script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/qrious@4.0.2/dist/qrious.min.js";
        script.onload = () => {
            const qr = new QRious({
                element: document.getElementById("qr-canvas"),
                value: qrPayload,
                size: 240
            });
        };
        document.body.appendChild(script);

        // simple countdown
        let seconds = 5 * 60;
        const tick = () => {
            const m = String(Math.floor(seconds / 60)).padStart(2, "0");
            const s = String(seconds % 60).padStart(2, "0");
            if (countdown) countdown.textContent = `${m}:${s}`;
            if (seconds > 0) {
                seconds -= 1;
                setTimeout(tick, 1000);
            }
        };
        tick();

        btn?.addEventListener("click", async () => {
            btn.disabled = true;
            try {
                const resp = await fetch(`/api/customer-booking/payment-confirm`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ token })
                });

                if (!resp.ok) {
                    const text = await resp.text();
                    throw new Error(text || resp.statusText);
                }

                result.classList.remove("d-none");
                setTimeout(() => window.location.assign("/my-bookings"), 1200);
            } catch (err) {
                alert(err.message || "Thanh toán thất bại");
                btn.disabled = false;
            }
        });
    </script>
}
